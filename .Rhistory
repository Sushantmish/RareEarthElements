par(mfrow = c(4, 4), mar = c(2, 2, 2, 1))
invisible(sapply(1:14, function(i) hist(chur_residual_matrix[, i], main = colnames(chur_residual_matrix)[i],col = "blue", breaks = 30, xlab = "")))
ref_ree_list <- list(
CHUR_1= c(), # avg CI Chondrite Sun and McDonough-1989
CHUR_2= c(), # avg CI Chondrite Pourmand et al 2012
CHUR_3  = c(), # avg CI Chondrite Barrat et al 2012
CHUR_4 = c(), # CI Chondrite volatile free
