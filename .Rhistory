#this is a function for extracting proper name for data downloaded from GeoRoc
combine_name <- function(input_file)
{
#split the string into rock name and part(if any)
directory_path <- dirname(input_file)
full_name <- basename(input_file)
split_name <- unlist(strsplit(full_name,"\\.(?=[^\\.]+$)", perl = TRUE))
if (length(split_name)!=2)
{
stop()
}
basename <- split_name[1]
file_extension <- paste0(".", split_name[2])
escaped_extension <- gsub("\\.", "\\\\.", file_extension)
all_files <- list.files(path = directory_path, full.names = FALSE)
pattern <- paste0("^", basename, "_part\\d+", escaped_extension, "$")
matching_files <- grep(pattern, all_files, value = TRUE)
if (length(matching_files) == 0) {
message(paste("No 'part' files found for basename:", basename))
return(invisible(NULL))
}
# 3. Sort files numerically
number_pattern <- paste0("^", basename, "_part(\\d+)", escaped_extension, "$")
file_numbers <- as.numeric(sub(number_pattern, "\\1", matching_files))
sorted_files <- matching_files[order(file_numbers)]
sorted_file_paths <- file.path(directory_path, sorted_files)
message(paste(
"Found", length(sorted_files), "files to combine."
))
# 4. Read and combine data
# Use lapply to read all files into a list
all_data_list <- lapply(sorted_file_paths, read.csv, stringsAsFactors = FALSE, ...)
# Combine the list of data frames
combined_data <- do.call(rbind, all_data_list)
# 5. Write output file
if (is.null(output_filename)) {
output_filename <- paste0(basename, "_combined", file_extension)
}
output_path <- file.path(directory_path, output_filename)
# Write the combined data
write.csv(combined_data, file = output_path, row.names = FALSE)
message(paste("Success! Combined data written to:", output_path))
return(invisible(output_path))
}
#this is a function for combining proper name for data downloaded from GeoRoc if a rock has multiple parts
original_rock_files <- list.files("~/Desktop/MSci Project/Original Data")
#this is a function for extracting proper name for data downloaded from GeoRoc
combine_name <- function(input_file)
{
#split the string into rock name and part(if any)
directory_path <- dirname(input_file)
full_name <- basename(input_file)
split_name <- unlist(strsplit(full_name,"\\.(?=[^\\.]+$)", perl = TRUE))
if (length(split_name)!=2)
{
stop()
}
basename <- split_name[1]
file_extension <- paste0(".", split_name[2])
escaped_extension <- gsub("\\.", "\\\\.", file_extension)
all_files <- list.files(path = directory_path, full.names = FALSE)
pattern <- paste0("^", basename, "_part\\d+", escaped_extension, "$")
matching_files <- grep(pattern, all_files, value = TRUE)
if (length(matching_files) == 0) {
message(paste("No 'part' files found for basename:", basename))
return(invisible(NULL))
}
# 3. Sort files numerically
number_pattern <- paste0("^", basename, "_part(\\d+)", escaped_extension, "$")
file_numbers <- as.numeric(sub(number_pattern, "\\1", matching_files))
sorted_files <- matching_files[order(file_numbers)]
sorted_file_paths <- file.path(directory_path, sorted_files)
message(paste(
"Found", length(sorted_files), "files to combine."
))
# 4. Read and combine data
# Use lapply to read all files into a list
all_data_list <- lapply(sorted_file_paths, read.csv, stringsAsFactors = FALSE, ...)
# Combine the list of data frames
combined_data <- do.call(rbind, all_data_list)
# 5. Write output file
if (is.null(output_filename)) {
output_filename <- paste0(basename, "_combined", file_extension)
}
output_path <- file.path(directory_path, output_filename)
# Write the combined data
write.csv(combined_data, file = output_path, row.names = FALSE)
message(paste("Success! Combined data written to:", output_path))
return(invisible(output_path))
}
